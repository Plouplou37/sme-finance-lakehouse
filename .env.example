# Copy to .env (ignored by Git). Fake values: Floci accepts any non-empty credentials.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
# For tools running on the host (uv run ...). Containers use http://floci:4566, set in docker-compose.yml.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_CONFIG_FILE=config/aws-config
# Kafka API from the host (Redpanda's external listener). Containers use redpanda:9092.
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
